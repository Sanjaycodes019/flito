{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:page(how-it-works|gallery|safety|about|mission|help|contact|terms|privacy).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/landing.en.html"
    },
    {
      "source": "/:page(how-it-works|gallery|safety|about|mission|help|contact|terms|privacy)",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/:page.en.html"
    },
    {
      "source": "/:page(how-it-works|gallery|safety|about|mission|help|contact|terms|privacy)",
      "destination": "/:page.ne.html"
    },
    { "source": "/(.*)", "destination": "/landing.ne.html" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
