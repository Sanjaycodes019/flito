MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/flito?retryWrites=true&w=majority
JWT_SECRET=replace_with_32+_char_random_string
JWT_EXPIRE=7d
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8081

# Required in production — without a gateway, OTPs are only logged to the
# server console and no real user can complete login.
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Optional: switches the OTP store from in-memory to Redis (needs `npm i redis`).
# REDIS_URL=redis://localhost:6379
