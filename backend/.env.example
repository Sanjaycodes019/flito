# Copy to .env and fill in. Never commit the real .env.

# --- Core ----------------------------------------------------------------
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8081
JWT_SECRET=replace_with_32+_char_random_string
JWT_EXPIRE=7d

# --- MongoDB Atlas ---------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/flito?retryWrites=true&w=majority

# --- Cloudinary (file uploads) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (verification and password-reset emails), required in production.
# Blank = the code is logged to the console instead of emailed, dev only.
# Get an API key from app.brevo.com > Settings > SMTP & API > API Keys.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FLITO

# --- Google sign-in, optional. Blank = the Google button reports "not
# configured" instead of failing confusingly. See README for setup steps.
GOOGLE_CLIENT_ID=

# --- Road distances (OSRM). Blank uses the free public demo server
# (about 1 request a second, answers are cached). For real traffic run your
# own OSRM server and set its URL, or set OSRM_URL=off to use straight-line
# estimates only. If the server is down, distances fall back to the estimate.
# OSRM_URL=https://router.project-osrm.org

# --- eSewa (sandbox), use the test merchant from developer.esewa.com.np ----
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# --- Khalti (sandbox), test secret key from test-admin.khalti.com ----------
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# --- Sparrow SMS, not currently used (auth no longer uses phone/OTP), kept
# in case a future feature (e.g. delivery SMS) wants it. ---------------------
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# --- Optional: Redis OTP store (needs `npm i redis`), unused for the same
# reason as Sparrow SMS above. ----------------------------------------------
# REDIS_URL=redis://localhost:6379

# Admin portal: secret required for admin login and signup. Unset = closed.
ADMIN_ACCESS_KEY=

# --- Observability, optional ---------------------------------------------
# Sentry error tracking. Blank = disabled.
SENTRY_DSN=
# pino log level: debug | info | warn | error | silent
LOG_LEVEL=info
