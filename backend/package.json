{
  "name": "flito-backend",
  "version": "1.0.0",
  "description": "FLITO Backend - Truck Booking Platform (Express + MongoDB + Socket.io)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "create-admin": "node scripts/createAdmin.js",
    "seed": "node scripts/seedDemo.js",
    "migrate-auth-indexes": "node scripts/migrateAuthIndexes.js"
  },
  "keywords": [
    "truck",
    "booking",
    "nepal",
    "logistics"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.3.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json"
  }
}
